# Not needed yet — added in Phase 4 (Supabase setup).
# Copy this file to .env.local and fill in values once a Supabase project exists.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Never put a service-role key in a NEXT_PUBLIC_ variable — it must stay
# server-only and unexposed to the browser.

# Admin area (Phase 11+). ADMIN_PASSWORD is the shared password used to log
# into /admin. ADMIN_SESSION_SECRET is a separate, unrelated random string
# used only to sign the session cookie — it should be long and random, not
# something you type in, and not the same value as ADMIN_PASSWORD.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cron keep-alive (deployment). Any long random string — Vercel attaches it
# automatically to its own scheduled requests once this env var exists in
# your Vercel project. Only needed in production, not for local dev.
CRON_SECRET=
